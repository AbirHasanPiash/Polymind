# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_,
# and everything here is bundled into the client — never put a secret in this file.

# Backend origin, without a trailing slash and without /api/v1.
# The WebSocket URL is derived from it (http -> ws, https -> wss).
VITE_API_URL="http://localhost:8000"

# Google OAuth client id for the "Continue with Google" button.
# Leave empty to hide the button entirely.
VITE_GOOGLE_CLIENT_ID=""
